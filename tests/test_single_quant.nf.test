nextflow_pipeline {

    name "Test pipeline for single replicate"
    script "../main.nf"
    tag "pipeline"
    tag "test_single_quant"
    profile "test_single_quant"

    test("-profile test_single_quant") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // Extract peptidoform column from all TSV files
            def peptidoform_data = []
            new File(params.outdir).eachFileRecurse { file ->
                if (file.name.endsWith('.tsv')) {
                    def lines = file.readLines()
                    if (lines.size() > 0) {
                        def header = lines[0].split('\t')
                        def peptidoformIndex = header.findIndexOf { it == 'peptidoform' }
                        if (peptidoformIndex >= 0) {
                            def peptidoforms = lines.drop(1).collect { line ->
                                def fields = line.split('\t')
                                fields.size() > peptidoformIndex ? fields[peptidoformIndex] : ''
                            }.findAll { it != '' }.sort()
                            // Identifications differ slightly between machines (DeepLC predictions are not bit-reproducible),
                            // so only the table structure and non-emptiness are snapshotted
                            peptidoform_data.add([file.name, header.toList(), peptidoforms.size() > 0])
                        }
                    }
                }
            }
            peptidoform_data = peptidoform_data.sort { it[0] }
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_mhcquant_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // Peptidoform data from TSV files
                    peptidoform_data
                ).match() }
            )
        }
    }
}
